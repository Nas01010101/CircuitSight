[Unit]
Description=CircuitSight — PCB Defect Detection Service
After=network.target

[Service]
Type=simple
User=circuitsight
Group=circuitsight
WorkingDirectory=/opt/circuitsight
ExecStart=/opt/circuitsight/venv/bin/uvicorn src.api.server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
